{
  "name": "catch-server",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Backend für Catch – Community-Hinweise im ÖPNV",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json && cp -r src/db/migrations dist/db/",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "seed:demo": "tsx --env-file-if-exists=.env src/db/seedDemo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync-contract": "cp src/contract.ts ../app/src/api/contract.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/websocket": "^11.3.7",
    "expo-server-sdk": "^8.0.0",
    "fastify": "^5.12.8",
    "firebase-admin": "^14.5.0",
    "lru-cache": "^11.5.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
