# --- Server ---
PORT=8080
HOST=0.0.0.0
# development | production
NODE_ENV=development
LOG_LEVEL=info
# Erlaubte Ursprünge für CORS (kommagetrennt), "*" = alle
CORS_ORIGIN=*

# --- Datenbank (PostgreSQL) ---
DATABASE_URL=postgres://catch:catch@localhost:5432/catch

# --- Login ---
# firebase = echte Firebase-ID-Tokens prüfen (Produktion)
# dev      = zusätzlich "Bearer dev:<name>" erlauben (NUR lokal, startet nicht mit NODE_ENV=production)
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=your-firebase-project

# --- Fahrplandaten (MOTIS) ---
# Öffentliche Instanz (Transitous) für Entwicklung & Start.
# Für Produktion mit vielen Nutzern: eigene MOTIS-Instanz (siehe docs/MOTIS.md), z. B. http://motis:8080
MOTIS_URL=https://api.transitous.org
# Bitte einen aussagekräftigen User-Agent mit Kontakt (z. B. Projekt-URL) setzen – das verlangt die Transitous-Nutzungsrichtlinie.
TRANSIT_USER_AGENT=catch-oepnv/0.1 (+https://github.com/PupJune2/Catch-)

# --- Push ---
# Optional: Firebase-Service-Account (JSON) → Push direkt über FCM an die Android-App
# FIREBASE_SERVICE_ACCOUNT_FILE=/pfad/zur/service-account.json
# Optional: Access-Token, falls "Enhanced Push Security" im Expo-Konto aktiv ist
EXPO_ACCESS_TOKEN=

# --- Regeln ---
# Meldungen gelten so viele Minuten als "aktuell"
RECENT_MINUTES=60
# Pro Nutzer & Linie höchstens 1 Meldung in diesem Zeitraum (Minuten)
REPORT_COOLDOWN_MINUTES=10
# Höchstzahl Meldungen pro Nutzer und Tag
REPORTS_PER_DAY=20
