# Adresse deines Catch-Servers (Hetzner). Lokal: http://localhost:8080
# Auf einem echten Handy im selben WLAN: http://<IP-deines-Rechners>:8080
EXPO_PUBLIC_API_URL=http://localhost:8080

# "dev" schaltet den Entwickler-Login frei (nur zusammen mit AUTH_MODE=dev auf dem Server!)
# Für echte Builds leer lassen → Login über Firebase.
EXPO_PUBLIC_AUTH_MODE=

# Optional: Firebase-Werte überschreiben (Standard steht in src/config.ts)
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
# EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Ko-fi-Spendenkarte im Profil ("Catch unterstützen"). "off" blendet sie aus,
# z. B. für Google-Play-Builds (Zahlungsrichtlinien, siehe docs/STORE.md).
# EXPO_PUBLIC_DONATIONS=
# EXPO_PUBLIC_DONATION_URL=https://ko-fi.com/catchline
